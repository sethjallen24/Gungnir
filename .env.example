# Copy to .env and fill in. Leave a platform's lines empty to hide it.

# The address people (and the platforms) reach Gungnir at. Must be https for TikTok,
# and reachable from the internet for Instagram photos. Locally, use a tunnel (see README).
PUBLIC_URL=http://localhost:3000
PORT=3000

# Where the database and uploaded files live. Use a persistent disk in production.
DATA_DIR=data

# Encrypts platform sign-ins in the database: 64 hex characters (openssl rand -hex 32).
# If left empty, one is generated into DATA_DIR/secret.key. Keep it with your backups.
SECRET_KEY=

# Meta (Facebook Pages + Instagram): developers.facebook.com → your app → App settings
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration ID (replaces the permission list).
META_CONFIG_ID=

# YouTube: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok: developers.tiktok.com → your app → Client key / Client secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
